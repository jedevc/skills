# Shared VHS style. Pull in with `Source <skill>/style.tape` before any Type.
Set Shell bash
Set FontSize 22
Set Padding 30
Set WindowBar Colorful
# frame.sh trims the empty strip under the buttons assuming this size.
Set WindowBarSize 60
# VHS fills the rounded corners with grey; frame.sh cuts them out again.
Set BorderRadius 14
Set Theme "Catppuccin Mocha"
Set TypingSpeed 40ms
Set WaitPattern /\$ ?$/
Env PS1 "$ "
